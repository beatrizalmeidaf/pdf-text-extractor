# Todas opcionais. Valores padrão entre parênteses.

# Tamanho máximo do upload em MB (100)
PTE_MAX_FILE_MB=100
# Máximo de páginas por requisição (5000)
PTE_MAX_PAGES=5000
# Processos de extração (nº de CPUs). Com 1 vCPU, use 1.
PTE_WORKERS=
# Requisições simultâneas antes de responder 503 (WORKERS * 4)
PTE_MAX_CONCURRENT_JOBS=
# Tempo máximo por requisição, em segundos (120)
PTE_REQUEST_TIMEOUT_S=120
# A partir de quantas páginas o PDF é dividido entre processos (16)
PTE_PARALLEL_THRESHOLD=16
# Chaves de API separadas por vírgula. Vazio = API aberta.
PTE_API_KEYS=
# Requisições por minuto por IP. 0 = sem limite. (0)
PTE_RATE_LIMIT_PER_MINUTE=0
# Origens liberadas no CORS, separadas por vírgula (*)
PTE_CORS_ORIGINS=*
# Servir a interface web em / (true)
PTE_ENABLE_UI=true
# Respostas guardadas em memória para uploads repetidos (64 entradas, 256 MB)
PTE_CACHE_ENTRIES=64
PTE_CACHE_MB=256

# --- Apache Tika ---
# Tika Server externo (ex.: http://tika:9998). Vazio = o app sobe o seu próprio.
PTE_TIKA_URL=
# Jar do Tika Server (a imagem Docker já traz um em /opt/tika)
PTE_TIKA_JAR=
# Flags da JVM do Tika
PTE_TIKA_JAVA_OPTS=-Xshare:auto -XX:+UseParallelGC
# Threads que conversam com o Tika em paralelo (4)
PTE_TIKA_THREADS=4
